# Local-dev defaults. Copy to .env and adjust.
APPNAME_DB_PATH=./appname.db
APPNAME_PORT=8081
APPNAME_BASE_URL=http://localhost:8081
# The org website (header tile, footer). Defaults to the website's dev
# server; https is required when APPNAME_PROD is on.
APPNAME_SITE_URL=http://localhost:4321
APPNAME_LOG_LEVEL=info

# voodoo owns sign-in. Run it locally on :8080 (see voodoo's docs/integration.md).
# https is required when APPNAME_PROD is on.
APPNAME_VOODOO_URL=http://localhost:8080

# Defaults to true, which requires an https APPNAME_BASE_URL. Off for local dev.
APPNAME_PROD=false

# Inngest (jobs). These are the SDK's own names; it reads them directly.
# Dev: any non-empty INNGEST_DEV (even 0) means the local dev server at
# http://127.0.0.1:8288; set it to a URL to point elsewhere. Start the dev
# server with: npx inngest-cli@latest dev -u http://localhost:8081/api/inngest
INNGEST_DEV=1
# Prod (APPNAME_PROD on): INNGEST_DEV must be unset and both keys are required,
# from the Inngest Cloud dashboard.
#INNGEST_SIGNING_KEY=signkey-prod-...
#INNGEST_EVENT_KEY=...
