# Production environment for appname, read by systemd (EnvironmentFile).
# On the server this lives at /etc/appname/appname.env (owned root, mode 0640,
# group appname). Copy this file there and adjust. It holds the Inngest keys.
# install.sh sources it as root, so keep it plain KEY=value, no quoting tricks.
APPNAME_DB_PATH=/var/lib/appname/appname.db
APPNAME_PORT=8081
# Interface the listener binds to. Caddy is the only intended client and
# proxies to 127.0.0.1, so keep this on loopback. Set to empty for all interfaces.
APPNAME_BIND=127.0.0.1
# Placeholders: appname.example.com is appname's host, auth.example.com is voodoo's.
# Both must be https in production.
APPNAME_BASE_URL=https://appname.example.com
APPNAME_VOODOO_URL=https://auth.example.com
# The org website, linked from the header and footer. Required (https)
# in production: the default is a localhost dev server.
APPNAME_SITE_URL=https://example.com
APPNAME_LOG_LEVEL=info
# APPNAME_PROD defaults to true; leave it unset. It makes appname refuse non-https
# URLs and missing Inngest keys. Never set INNGEST_DEV here: prod refuses it.
#
# Inngest Cloud keys (app "appname"), from the Inngest dashboard.
INNGEST_SIGNING_KEY=signkey-prod-...
INNGEST_EVENT_KEY=
